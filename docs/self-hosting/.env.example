# ============ AA Computer 自托管 Supabase 配置示例 ============
# 不要直接使用本文件！运行以下命令生成真实密钥：
#   node scripts/generate-supabase-keys.mjs > docs/self-hosting/.env
# 然后把本文件剩余字段按你的环境改好。

# 数据库与 JWT 主密钥（由生成脚本产出）
POSTGRES_PASSWORD=your-postgres-password
JWT_SECRET=your-jwt-secret
JWT_EXPIRY=3600

# API 密钥（由生成脚本产出；前端 VITE_SUPABASE_KEY 使用 ANON_KEY）
ANON_KEY=your-anon-jwt
SERVICE_ROLE_KEY=your-service-role-jwt

# 对外暴露的 Kong 端口。服务器上用 80/443（配反向代理）；与本地 CLI 栈共存时改端口
KONG_HTTP_PORT=8000

# SITE_URL：前端页面的访问地址（http://localhost:5173 或 https://app.example.com）
SITE_URL=http://localhost:5173
# API_EXTERNAL_URL：Kong 的公网地址 + /auth/v1（https://api.example.com/auth/v1 或 http://127.0.0.1:8000/auth/v1）
API_EXTERNAL_URL=http://127.0.0.1:8000/auth/v1
# 允许跳转的额外地址，逗号分隔；不需要可留空
ADDITIONAL_REDIRECT_URLS=

# 保留占位（精简方案不含 Studio）
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=change-me
