{
  // VSCode Dev Containers 配置
  // 用法: VSCode 左下角 > 远程连接 > Reopen in Container
  "name": "aa-computer dev",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteUser": "node",

  // 挂载宿主机 Docker socket (Linux / macOS / Windows 由官方 feature 自动适配),
  // 用于在容器内把自身接入宿主机 Supabase 的 Docker 网络。
  // 注意: feature 的 socket 代理脚本需要 sudo (Dockerfile 已安装), 改动后需 Rebuild Container 生效
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },

  // IO 优化: 把 node_modules 与 pnpm store 放到命名卷, 避免大量小文件走
  // Windows bind mount (NTFS -> VirtioFS/9p) 导致的性能损耗和 9p 卡死问题。
  // 源码等仍保持 bind mount, 与宿主机实时同步关系不变。
  // - 同一个卷挂两个位置, pnpm 硬链接 (store -> node_modules) 才能生效
  // - 命名卷跨容器重建保留, 依赖只需在卷首次创建时安装一次
  // - 首次挂载时 Docker 会把宿主机 node_modules/.pnpm-store 复制进卷 (仅一次较慢)
  // - 注意: 容器内 node_modules 与宿主机不再共享; 若删除该卷, 需在容器内重新 pnpm install
  // 空卷首次挂载属主为 root, setup.sh 会自动 chown 给 node (幂等)
  // 改动后需 Rebuild Container 生效
  "mounts": [
    {
      "source": "aa-computer-deps",
      "target": "/workspaces/aa-computer/node_modules",
      "type": "volume"
    },
    {
      "source": "aa-computer-deps",
      "target": "/workspaces/aa-computer/.pnpm-store",
      "type": "volume"
    },
    // 宿主机 SSH 凭据 (~/.ssh) 挂载, 容器内 git push 直接可用 (需 Rebuild Container 生效)
    {
      "source": "${localEnv:USERPROFILE}/.ssh",
      "target": "/home/node/.ssh",
      "type": "bind"
    }
  ],
  "remoteEnv": {
    "GIT_SSH_COMMAND": "ssh -o StrictHostKeyChecking=accept-new"
  },

  // Codex CLI 配置不与宿主机 Windows 同步（跨系统兼容性差），容器内独立使用
  // 注意: 登录态随容器重建丢失, 重建后需在容器内重新 codex login

  // Vite dev server 端口转发到宿主机
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server", "onAutoForward": "notify" }
  },

  // 前端在宿主机浏览器运行, 直接访问宿主机的 Supabase (http://127.0.0.1:54321);
  // 容器内已挂载 Docker socket, setup.sh 会将容器接入 Supabase 网络,
  // 之后容器内可用 http://supabase-kong-<project>:8000 直接访问 API

  "customizations": {
    "vscode": {
      "extensions": ["Vue.volar"]
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh"
}
